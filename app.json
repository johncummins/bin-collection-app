{
  "expo": {
    "name": "Cambridge Bins",
    "slug": "bin-collection-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bin.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Never miss your bin collection day again! Cambridge Bins helps residents stay on top of their waste collection schedule with personalized notifications and smart reminders.",
    "keywords": [
      "waste management",
      "bin collection",
      "recycling",
      "Cambridge",
      "notifications",
      "schedule",
      "environment",
      "sustainability"
    ],
    "privacy": "https://cambridge-bins.vercel.app/privacy",
    "supportUrl": "https://cambridge-bins.vercel.app/support",
    "homepage": "https://cambridge-bins.vercel.app",
    "author": "Cambridge Bins Team",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cummins.bincollectionapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to help you find your nearest bin collection schedule.",
        "NSUserNotificationsUsageDescription": "This app sends notifications to remind you about your bin collection days."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bin.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cummins.bincollectionapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/bin.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bin.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a8256843-8113-4935-9dfc-77babe825728"
      }
    }
  }
}
